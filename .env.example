# Copy to .env locally. Do not paste real secrets into chat or commit them.

# Runtime.
SECRETARY_RUNTIME_MODE=dry_run
SECRETARY_PUBLIC_HOST=secretary.vacanator.xyz
SECRETARY_TLS_WEBHOOK_ENABLED=false
SECRETARY_HEALTH_HOST=127.0.0.1
SECRETARY_HEALTH_PORT=18097

# Telegram user account MTProto access via Telethon.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_PHONE_NUMBER=
TELEGRAM_USER_INGEST_ENABLED=false
TELEGRAM_USER_CLIENT=telethon
TELEGRAM_USER_SESSION_DIR=./data/telegram-user-telethon
TELEGRAM_USER_FILES_DIR=./data/telegram-user-files
TELEGRAM_USER_ANALYSIS_MAX_MESSAGES=200

# Telegram bot used as the private secretary chat.
TELEGRAM_BOT_TOKEN=
SECRETARY_OWNER_TELEGRAM_ID=
TELEGRAM_BOT_DELIVERY_MODE=polling
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SEND_STARTUP_TEST_MESSAGE=false

# Comma-separated Telegram sender IDs allowed to receive safe calendar auto-replies.
AUTO_REPLY_TRUSTED_SENDER_IDS=
AUTO_REPLY_ENABLED=false
AUTO_REPLY_MIN_CONFIDENCE=0.85

# Apple Calendar integration. Use read-only access on the local macOS account.
CALENDAR_PROVIDER=icloud_caldav
APPLE_CALENDAR_IDS=
APPLE_CALENDAR_LOOKAHEAD_DAYS=7
APPLE_CALENDAR_CALDAV_URL=https://caldav.icloud.com
APPLE_CALENDAR_USERNAME=
APPLE_CALENDAR_APP_PASSWORD=

# Craft notes/tasks integration. Prefer a local Craft export for the first release.
CRAFT_SOURCE_MODE=markdown_export
CRAFT_EXPORT_DIR=./data/craft-export
CRAFT_TODAY_DOCUMENT_ID=
CRAFT_TASKS_DOCUMENT_ID=

# Voice calls. Keep outbound calls disabled until the owner phone number and rules are verified.
VOICE_PROVIDER=dry_run
VOICE_OWNER_PHONE_E164=
VOICE_OUTBOUND_ENABLED=false
VOICE_QUIET_HOURS=22:00-09:00
CALL_REMINDER_MIN_PRIORITY=high
CALL_REMINDER_RATE_LIMIT_PER_DAY=3

# Business research calls. Default is dry-run: /call renders the script but does not call.
VOICE_BUSINESS_CALLS_ENABLED=false
VOICE_BUSINESS_CALL_PROVIDER=dry_run
VOICE_BUSINESS_CALL_ALLOWED_PREFIXES=+7
VOICE_BUSINESS_CALL_MAX_DURATION_SECONDS=480
VOICE_WEBHOOK_BASE_URL=
VOICE_WEBHOOK_SECRET=

# Twilio transport for real outbound business calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_E164=

# LLM post-processing for call transcripts. rule_based works offline.
CALL_ANALYSIS_PROVIDER=rule_based
LLM_WORKER_URL=
LLM_WORKER_BEARER_TOKEN=

# Optional STT for Russian recordings before LLM post-processing.
VOICE_RECORDING_TRANSCRIBER=disabled
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper

# Optional future LLM provider for classification/drafts.
OPENAI_API_KEY=

# Local storage.
DATABASE_PATH=./data/secretary.sqlite3
DEFAULT_TIMEZONE=Europe/Moscow
