# Secret runtime settings.
# Copy to /etc/telegram-secretary/secrets.env, chmod 0600, then fill locally on the server.
# Do not commit real values and do not paste them into chat.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_PHONE_NUMBER=
TELEGRAM_BOT_TOKEN=
SECRETARY_OWNER_TELEGRAM_ID=
AUTO_REPLY_TRUSTED_SENDER_IDS=

# Apple Calendar/iCloud CalDAV credentials. Fill only on the server.
APPLE_CALENDAR_USERNAME=
APPLE_CALENDAR_APP_PASSWORD=

# Optional LLM and voice provider credentials.
OPENAI_API_KEY=
VOICE_OWNER_PHONE_E164=
VOICE_PROVIDER_ACCOUNT_ID=
VOICE_PROVIDER_AUTH_TOKEN=
VOICE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_E164=
EXOLVE_API_KEY=
EXOLVE_SOURCE_PHONE=
VOXIMPLANT_CREDENTIALS_JSON=
VOXIMPLANT_SIP_AUTH_USER=
LLM_WORKER_URL=
LLM_WORKER_BEARER_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
