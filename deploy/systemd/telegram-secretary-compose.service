[Unit]
Description=Telegram Secretary isolated Docker Compose service
Documentation=file:/opt/telegram-secretary/app/docs/deployment-plan.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/telegram-secretary/app/deploy/compose
Environment=COMPOSE_PROJECT_NAME=telegram-secretary
ExecStart=/usr/bin/docker compose --env-file /etc/telegram-secretary/compose.env -f docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/telegram-secretary/compose.env -f docker-compose.yml down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

