[Unit]
Description=Telegram Secretary isolated Docker service
Documentation=file:/opt/telegram-secretary/app/docs/deployment-plan.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/telegram-secretary/compose.env
ExecStartPre=-/usr/bin/docker rm -f telegram-secretary-app
ExecStart=/usr/bin/docker run \
  --name telegram-secretary-app \
  --pull=never \
  --env-file /etc/telegram-secretary/runtime.env \
  --env-file /etc/telegram-secretary/secrets.env \
  --env SECRETARY_HEALTH_HOST=0.0.0.0 \
  --env SECRETARY_HEALTH_PORT=8080 \
  --publish ${SECRETARY_HOST_BIND}:${SECRETARY_HOST_PORT}:8080 \
  --volume /var/lib/telegram-secretary/data:/app/data \
  --volume /var/lib/telegram-secretary/sessions:/app/sessions \
  --volume /var/lib/telegram-secretary/asterisk:/app/asterisk \
  --volume /var/lib/telegram-secretary/craft-export:/app/data/craft-export:ro \
  --security-opt no-new-privileges:true \
  --cap-drop ALL \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  telegram-secretary:local
ExecStop=/usr/bin/docker stop telegram-secretary-app
ExecStopPost=-/usr/bin/docker rm -f telegram-secretary-app
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
